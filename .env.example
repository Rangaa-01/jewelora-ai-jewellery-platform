# Root environment file used by docker-compose. For local (non-Docker) development use
# backend/.env and frontend/.env.local instead (see docs/setup.md).
POSTGRES_DB=jewelora
POSTGRES_USER=jewelora
POSTGRES_PASSWORD=change-me
POSTGRES_HOST_PORT=5433
HTTP_PORT=8080
PUBLIC_BASE_URL=http://localhost:8080

APP_ENV=development
SECRET_KEY=change-me-to-a-long-random-string
COOKIE_SECURE=false
STORAGE_BACKEND=local
AI_ENABLED=true
LLM_PROVIDER=none
PAYMENT_PROVIDER=none
